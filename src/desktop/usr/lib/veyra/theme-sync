#!/usr/bin/env python3
"""Keep the VeyraOS window title bars in sync with the light/dark colour scheme.

Plasma's global-theme switch (including automatic day/night switching) does
not always change the window decoration. This switches between the VeyraOS
Light and Dark title bars to match the active colour scheme. It only acts
when a VeyraOS title bar is in use, so a decoration the user picked
themselves is never overridden. Runs at login and from VeyraOS Control.
"""
import configparser
import os
import subprocess

LIGHT, DARK = "__aurorae__svg__Veyra", "__aurorae__svg__VeyraDark"
CFG = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))


def read(name, group, key):
    """Value from the user's file, falling back to the system default (/etc/xdg)."""
    for base in (CFG, "/etc/xdg"):
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        cp.optionxform = str
        try:
            cp.read(os.path.join(base, name), encoding="utf-8")
        except (configparser.Error, UnicodeDecodeError):
            continue
        if cp.has_option(group, key):
            return cp.get(group, key)
    return ""


def is_dark_scheme() -> bool:
    # The actual window colour is authoritative (Plasma does not always store
    # the scheme name when a global theme is applied).
    bg = read("kdeglobals", "Colors:Window", "BackgroundNormal")
    try:
        r, g, b = (int(x) for x in bg.split(",")[:3])
        return (r * 299 + g * 587 + b * 114) / 1000 < 128
    except ValueError:
        return "dark" in read("kdeglobals", "General", "ColorScheme").lower()


def main() -> int:
    current = read("kwinrc", "org.kde.kdecoration2", "theme")
    if current not in (LIGHT, DARK):
        return 0  # not a VeyraOS title bar: respect the user's choice
    wanted = DARK if is_dark_scheme() else LIGHT
    if wanted == current:
        return 0
    for tool in ("kwriteconfig6", "kwriteconfig5"):
        try:
            subprocess.run([tool, "--file", "kwinrc", "--group", "org.kde.kdecoration2", "--key", "theme", wanted],
                           check=True)
            subprocess.run([tool, "--file", "kwinrc", "--group", "org.kde.kdecoration2", "--key", "library",
                            "org.kde.kwin.aurorae"], check=True)
            break
        except (OSError, subprocess.CalledProcessError):
            continue
    for q in ("qdbus6", "qdbus"):
        try:
            subprocess.run([q, "org.kde.KWin", "/KWin", "reconfigure"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=10)
            break
        except (OSError, subprocess.TimeoutExpired):
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
