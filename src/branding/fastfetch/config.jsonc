// VeyraOS default fastfetch configuration (users can override in ~/.config/fastfetch/)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/veyra/fastfetch/logo.txt",
    "color": { "1": "38;2;139;92;246", "2": "38;2;56;189;248", "3": "38;2;224;231;255" },
    "padding": { "right": 3 }
  },
  "display": { "color": { "keys": "38;2;139;92;246" }, "separator": "  " },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages", "shell",
    "de", "wm", "terminal", "cpu", "gpu", "memory", "swap", "disk", "break", "colors"
  ]
}
