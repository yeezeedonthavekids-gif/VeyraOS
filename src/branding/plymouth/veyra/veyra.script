# VeyraOS boot animation (Plymouth script plugin).
# Logo in the centre, an orbiting-dots spinner below it, a password box for
# encrypted disks, and status messages at the bottom.

Window.SetBackgroundTopColor(0.020, 0.024, 0.059);
Window.SetBackgroundBottomColor(0.020, 0.024, 0.059);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;
cy = Window.GetY() + screen_h / 2;

# --- logo ------------------------------------------------------------------
logo.image = Image("logo.png");
scale = 1;
if (screen_h < 900) scale = 0.75;
logo.image = logo.image.Scale(logo.image.GetWidth() * scale, logo.image.GetHeight() * scale);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(cx - logo.image.GetWidth() / 2);
logo.sprite.SetY(cy - logo.image.GetHeight() / 2 - 40 * scale);
logo.sprite.SetZ(10);

# --- spinner: 6 dots orbiting with easing (accelerate at the bottom) --------
NDOTS = 6;
dot_image = Image("dot.png");
spin_r = 22 * scale;
spin_cx = cx;
spin_cy = cy + logo.image.GetHeight() / 2 + 60 * scale;
for (i = 0; i < NDOTS; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetZ(10);
    dots[i].SetOpacity(0);
}
frame = 0;
spinner_visible = 1;

fun ease(p) {
    # p in [0,1): smooth step with fast middle section
    return p - Math.Sin(p * 2 * Math.Pi) / (2 * Math.Pi);
}

fun refresh_callback() {
    frame++;
    if (!spinner_visible) {
        for (i = 0; i < NDOTS; i++) dots[i].SetOpacity(0);
        return;
    }
    period = 110;
    for (i = 0; i < NDOTS; i++) {
        local.p = (frame - i * 6) % period;
        if (local.p < 0) local.p += period;
        local.t = local.p / period;
        if (local.t < 0.8) {
            local.a = ease(local.t / 0.8) * 2 * Math.Pi + Math.Pi / 2;
            dots[i].SetX(spin_cx + spin_r * Math.Cos(local.a) - dot_image.GetWidth() / 2);
            dots[i].SetY(spin_cy + spin_r * Math.Sin(local.a) - dot_image.GetHeight() / 2);
            dots[i].SetOpacity(1);
        } else {
            dots[i].SetOpacity(0);
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- messages ----------------------------------------------------------------
message_sprite = Sprite();
message_sprite.SetZ(20);
fun message_callback(text) {
    message_image = Image.Text(text, 0.75, 0.78, 0.85, 1, "Sans 11");
    message_sprite.SetImage(message_image);
    message_sprite.SetX(cx - message_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetY() + screen_h - 60);
}
Plymouth.SetMessageFunction(message_callback);

# --- password prompt (encrypted disks) --------------------------------------
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetZ(30);
entry.sprite.SetOpacity(0);
prompt_sprite = Sprite();
prompt_sprite.SetZ(30);

fun hide_password() {
    entry.sprite.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}

fun display_password_callback(prompt, count) {
    spinner_visible = 0;
    for (i = 0; i < NDOTS; i++) dots[i].SetOpacity(0);
    ex = cx - entry.image.GetWidth() / 2;
    ey = spin_cy - entry.image.GetHeight() / 2;
    entry.sprite.SetPosition(ex, ey, 30);
    entry.sprite.SetOpacity(1);
    prompt_image = Image.Text(prompt, 0.85, 0.87, 0.95, 1, "Sans 11");
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(cx - prompt_image.GetWidth() / 2, ey - prompt_image.GetHeight() - 10, 30);
    prompt_sprite.SetOpacity(1);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    shown = count;
    if (shown > 24) shown = 24;
    for (i = 0; i < shown; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(ex + 14 + i * (bullet.image.GetWidth() + 4), ey + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2, 31);
        bullets[i].SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    hide_password();
    spinner_visible = 1;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun quit_callback() {
    spinner_visible = 0;
    for (i = 0; i < NDOTS; i++) dots[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
